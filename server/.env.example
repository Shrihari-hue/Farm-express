# MongoDB connection string (Atlas M0 free tier is fine — it always provisions a replica set,
# which is required for the multi-document transaction used by POST /api/profile/complete).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/farm_express?retryWrites=true&w=majority

# Secret used to sign/verify JWT access tokens. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Port the Express server listens on.
PORT=4000

# Public base URL of this server, used to build absolute URLs for uploaded worker photos
# (e.g. http://localhost:4000 in dev, or your deployed API's public URL in production).
SERVER_BASE_URL=http://localhost:4000
